# ==============================================================================
# Alkame Nifty50 Educational Platform - Production Environment Variables
# Copy this file to .env and replace placeholder values before running in production.
# ==============================================================================

# --- Application & Security Settings ---
# Enable or disable API authentication (Default: true in production)
ALKAME_API_AUTH_ENABLED=true

# Secure API Keys for RBAC (REPLACE THESE WITH STRONG SECRETS IN PRODUCTION)
ALKAME_ADMIN_KEY=dev-alkame-admin-key-change-in-production
ALKAME_READONLY_KEY=dev-alkame-readonly-key-change-in-production

# CORS allowed origins (comma-separated list of trusted origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost

# --- Database Configuration ---
# Database connection URL (Supports SQLite file or PostgreSQL connection URI)
# SQLite default: sqlite:///db/predictor.sqlite3
# PostgreSQL example: postgresql://user:password@localhost:5432/alkame_db
DATABASE_URL=sqlite:///db/predictor.sqlite3

# --- Observability & Logging ---
# Log output format: 'json' for production/containerized environments, 'text' for local dev
LOG_FORMAT=json

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- External API Providers ---
# MarketAux API Key for external news feed integration (optional)
MARKETAUX_API_KEY=

# IMD API Key for macro weather data (optional)
IMD_API_KEY=
